# ==============================================================================
# NexaTech On-Premise RAG Service Environment Configuration
# ==============================================================================

# [Mode 1: On-Premise GPU Inference (DGX Spark / sglang)]
# Used for local demo and private enterprise infrastructure
LLM_BASE_URL=http://spark-f5e2.tail0bfda4.ts.net:8000/v1
LLM_MODEL=Inferact/Qwen3.8-Flash-Next-NVFP4
LLM_API_KEY=not-needed

# [Mode 2: Cloud Fallback / BYOK Mode (Bring Your Own Key)]
# Used for public Vercel deployment when on-premise endpoint is not directly reachable
BYOK_BASE_URL=https://api.openai.com/v1
BYOK_MODEL=gpt-4o-mini

# [Search Configuration]
# Minimum BM25 confidence threshold for grounding verification
RAG_REJECTION_THRESHOLD=12.0
RAG_TOP_K=4
